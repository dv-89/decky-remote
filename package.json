{
  "name": "decky-remote",
  "version": "0.1.10",
  "description": "Laptop keyboard and mouse for SteamOS through a paired local browser",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python -m unittest discover -s tests -v",
    "test:client": "node --test tests/client.test.mjs",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "package": "python scripts/package.py",
    "test:dolphin": "node --test tests/dolphin.test.mjs"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/ui": "4.12.1",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "rollup-plugin-external-globals": "0.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.64.5",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
